{
  "name": "openclaw-aipg-provider",
  "version": "0.6.3",
  "description": "AI Power Grid for OpenClaw: images, video, text models, a council of models, wallet sign-in (unofficial, community-built)",
  "type": "module",
  "license": "MIT",
  "author": "speteai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speteai/openclaw-aipg-provider.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "provider",
    "aipg",
    "ai-power-grid"
  ],
  "files": [
    "index.js",
    "grid.js",
    "safe.js",
    "images.js",
    "video.js",
    "tools.js",
    "wallet.js",
    "tx.js",
    "holder.js",
    "bin",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "providers": [
      "aipg"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3",
      "minGatewayVersion": "2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3",
      "pluginSdkVersion": "2026.11.3"
    }
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "bin": {
    "aipg-wallet-login": "./bin/wallet-login.js",
    "aipg-wallet-fund": "./bin/wallet-fund.js",
    "aipg-wallet-holder": "./bin/wallet-holder.js"
  },
  "scripts": {
    "test": "node test/unit.mjs"
  }
}
